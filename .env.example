# Live AI (Google AI Studio → Get API key). Without it, the 10 sample submissions use their saved readings.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.5-flash; falls back to Flash-Lite models)
GEMINI_MODEL=
# Database (Supabase). The anon key is public by design; every table is locked by RLS to requests that carry VETTED_DB_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VETTED_DB_KEY=
# Public URL used in fix links sent to vendors
PUBLIC_URL=https://vetted-onboarding.vercel.app
